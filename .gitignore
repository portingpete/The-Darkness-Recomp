# --- Game dump (copyrighted, user-provided; see README) ---
# Keep only the small RE analysis file; ignore the binaries and game data.
Darkness/*
!Darkness/darkness_switch_tables.toml

# --- Stale generated PPC output ---
# Canonical AOT output is regenerated into build_native/generated by
# tools/recompile.py (see tools/build.ps1). The root ppc/ tree is legacy.
ppc/

# --- Vendored reference clones (build-time dependencies, see README) ---
# tools/setup_generator.py fetches and patches the pinned XenonRecomp source.
# The patch itself is tracked under tools/patches/.
refs/

# --- Build outputs ---
build/
build_native/
build_clang/
out/
$canaryDir/
$masterDir/

# --- Visual Studio / ClangCL ---
.vs/
*.user
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
Debug/
Release/
x64/
*.ilk
*.pdb
*.tlog
*.lastbuildstate
*.idb

# --- Local probe / object artifacts ---
*.obj

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.venv/
venv/

# --- Local-only runtime files: logs, crash dumps, settings, saves ---
*.log
darkrecomp_*.txt
*.ini
saves/

# --- Local Xenia emulator checkout / captures ---
xenia/

# --- IDA / Ghidra databases ---
*.id0
*.id1
*.nam
*.til
*.idc
*.i64
*.gdb

# --- Generated native menu assets staged beside the exe ---
CubeWnd.pc.xcr
GameContext_Create.pc.xdf

# --- Local research / scratch dirs ---
.baseline/
task/
queue-pacing-*/
find-fix-*/
find-fix-path-buffers/

# --- Regenerable dev artifacts (rebuild with tools/build_atlas.py) ---
tools/code_atlas.json

# --- OS ---
Thumbs.db
Desktop.ini
.DS_Store
