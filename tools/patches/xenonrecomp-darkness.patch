+// Traverse control flow, including recovered switch edges. Do not compile the
+// inline address tables as instructions or truncate leaf functions at bctr.
+// Calls and known external tail calls remain calls; no guest instructions run
+// during this analysis. The output remains entirely ahead-of-time C++.
+void Recompiler::FindReachableInstructions(const Function& fn)
+{
+    instructionAddresses.clear();
+    const Section* section = nullptr;
+    for (const auto& candidate : image.sections)
+        if ((candidate.flags & SectionFlags_Code) && fn.base >= candidate.base &&
+            fn.base < candidate.base + candidate.size) section = &candidate;
+    if (!section) return;
+
+    std::vector<size_t> pending{fn.base};
+    auto isExternalFunction = [&](size_t address) {
+        auto symbol = image.symbols.find(address);
+        return (address < fn.base || address >= fn.base + fn.size) &&
+            symbol != image.symbols.end() && symbol->address == address &&
+            symbol->type == Symbol_Function;
+    };
+    while (!pending.empty())
+    {
+        size_t pc = pending.back();
+        pending.pop_back();
+        while (pc >= section->base && pc + 4 <= section->base + section->size && (pc & 3) == 0)
+        {
+            if (!instructionAddresses.emplace(pc).second) break;
+            uint32_t word = ByteSwap(*(const uint32_t*)image.Find(pc));
+            auto table = config.switchTables.find(pc);
+            if (table != config.switchTables.end())
+                for (uint32_t target : table->second.labels) pending.push_back(target);
+            uint32_t op = PPC_OP(word);
+            if (word == 0) break;
+            if (op == PPC_OP_B && !PPC_BL(word))
+            {
+                size_t target = PPC_BA(word) ? uint32_t(PPC_BI(word)) : pc + PPC_BI(word);
+                if (!isExternalFunction(target)) pending.push_back(target);
+                break;
+            }
+            if (op == PPC_OP_BC && !PPC_BL(word))
+            {
+                size_t target = PPC_BA(word) ? uint32_t(PPC_BD(word)) : pc + PPC_BD(word);
+                if (!isExternalFunction(target)) pending.push_back(target);
+            }
+            if (op == PPC_OP_CTR && !PPC_BL(word))
+            {
+                uint32_t xo = PPC_XOP(word);
+                // Unconditional bclr/bcctr end the block; conditional returns
+                // also have a fallthrough edge.
+                if ((xo == 16 || xo == 528) && (((word >> 21) & 20) == 20)) break;
+            }
+            pc += 4;
+        }
+    }
+}
